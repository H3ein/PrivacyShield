{
  "manifest_version": 2,
  "name": "PrivacyShield Max",
  "version": "2.0.0",
  "description": "Maximum privacy protection with AI-powered learning, tracking protection, and CNAME uncloaking",

  "permissions": [
    "storage",
    "tabs",
    "notifications",
    "activeTab",
    "contextMenus",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],

  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],

  "options_ui": {
    "page": "ui/settings.html",
    "open_in_tab": true
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "browser_action": {
    "default_popup": "ui/popup.html",
    "default_title": "PrivacyShield Max",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
